{
  "name": "ace-tracer",
  "private": true,
  "type": "module",
  "workspaces": [
    "types",
    "lib",
    "demo"
  ],
  "scripts": {
    "build": "turbo build",
    "check": "turbo lint tsc && bun run format",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "biome check --write . && prettier --write --log-level warn \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome check . && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "lint": "turbo lint",
    "ncu": "bun run scripts/check-updates.ts",
    "ncu:apply": "bun run scripts/check-updates.ts --apply",
    "test": "turbo run test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "tsc": "turbo tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
